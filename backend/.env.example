# ===================== App =====================
APP_NAME="RoboKitchen Ordering System"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
ENABLE_DOCS=true                   # Swagger at /api/v1/docs (set false in production if you want)
API_PREFIX=/api/v1

# ===================== Security =====================
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_EMAIL_VERIFICATION=false   # true = users must click the email link before logging in
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true

# ===================== MongoDB =====================
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017
# Demo without any database: mongomock://   (in-memory, needs requirements-dev.txt)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=robokitchen

# ===================== Redis (optional) =====================
# Needed only when you run more than one worker/instance (shared rate limits + WebSocket fan-out)
REDIS_URL=

# ===================== Email (SMTP) =====================
# Leave SMTP_HOST empty in development: emails (with verification links) are printed to the console.
# Gmail: smtp.gmail.com / 587 / your address / 16-char App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=noreply@robokitchen.com
EMAIL_FROM_NAME=RoboKitchen

# ===================== Frontend / CORS =====================
FRONTEND_URL=http://localhost:3000             # used in email links and QR codes
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================== Payments =====================
PAYMENT_PROVIDER=mock              # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# ===================== Robot kitchen =====================
KITCHEN_API_KEY=dev-kitchen-key-change-me
KITCHEN_WEBHOOK_URL=               # optional: backend POSTs new jobs here

# ===================== Business defaults (editable later in Admin > Settings) =====================
TAX_RATE=0.08
SERVICE_FEE_CENTS=0
POINTS_PER_DOLLAR=10
POINT_VALUE_CENTS=1
MIN_POINTS_TO_REDEEM=100
MAX_REDEEM_PERCENT=50
SILVER_THRESHOLD=500
GOLD_THRESHOLD=2000
PLATINUM_THRESHOLD=5000

# ===================== Misc =====================
CART_TTL_HOURS=24
SEED_ON_STARTUP=false              # true = load demo menu/users on first start if the DB is empty
